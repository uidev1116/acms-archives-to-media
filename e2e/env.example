# プラグインのルートに .env.local としてコピーして使う（.env.local はコミットしない）。
# E2E 用に、子ブログ a2m-test へログインできる管理者を指定する。
A2M_ADMIN_MAIL=
A2M_ADMIN_PASS=

# 任意（既定値は README を参照）
