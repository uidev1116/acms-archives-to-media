{
  "name": "acms-archives-to-media",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ArchivesToMedia admin UI (React 19 + @ablogcms/components)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "npm run lint:eslint && npm run lint:prettier && npm run lint:stylelint",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check \"frontend/**/*.{ts,tsx}\" \"e2e/**/*.ts\" playwright.config.ts package.json tsconfig.json vite.config.ts eslint.config.js \"src/assets/css/*.css\"",
    "lint:stylelint": "stylelint \"src/assets/css/*.css\"",
    "lint:fix": "eslint . --fix && prettier --write \"frontend/**/*.{ts,tsx}\" \"e2e/**/*.ts\" playwright.config.ts package.json tsconfig.json vite.config.ts eslint.config.js \"src/assets/css/*.css\" && stylelint \"src/assets/css/*.css\" --fix",
    "format": "prettier --write \"frontend/**/*.{ts,tsx}\" \"e2e/**/*.ts\" playwright.config.ts package.json tsconfig.json vite.config.ts eslint.config.js \"src/assets/css/*.css\"",
    "check": "npm run lint && npm run typecheck && npm run test",
    "e2e": "playwright test",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@ablogcms/components": "3.2.37",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.4.2",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^3.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,css}": [
      "prettier --write"
    ],
    "src/assets/css/*.css": [
      "stylelint --fix"
    ]
  }
}
