{
    "name": "ablogcms/archives-to-media",
    "description": "a-blog cms plugin: bulk-convert archives/ images and files referenced by units and custom fields into media references",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "uidev1116"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "ext-zip": "*",
        "ablogcms/testing-framework": "3.2.*",
        "phpcompatibility/php-compatibility": "^10.0@dev",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Acms\\Plugins\\ArchivesToMedia\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Acms\\Plugins\\ArchivesToMedia\\Tests\\": "tests/phpunit/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/phpcs --standard=phpcs.xml.dist",
        "format": "vendor/bin/phpcbf --standard=phpcs.xml.dist",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "package": "@php scripts/package.php",
        "version:set": "@php scripts/version.php",
        "release:patch": "@php scripts/release.php patch",
        "release:minor": "@php scripts/release.php minor",
        "release:major": "@php scripts/release.php major"
    },
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpcsstandards/composer-installer": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.5.0"
        }
    }
}
